{
  "type"           : "module",
  "devDependencies": {"critical": "^8.0.0", "sharp": "^0.35.3", "terser": "^5.49.2"},
  "scripts"        : {
    "minify": "pwsh -NoProfile -Command \"Get-ChildItem js/*.js -Exclude *.min.js | ForEach-Object { terser $_.FullName --compress --mangle -o $_.FullName }\"",
    "critical": "node critical.mjs",
    "build": "npm run minify && npm run critical"
  }
}
